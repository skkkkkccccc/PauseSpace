{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pausespace.local/content/schema.json",
  "title": "PauseSpace scene script",
  "description": "Reusable ~3-minute scene script: ordered segments with a timing budget, optionality/exit fields, same-origin transcript and audio metadata, and a review state. Non-diagnostic; no forced breathing or autoplay. Synthetic or properly anonymized data only.",
  "type": "object",
  "required": ["id", "title", "durationSeconds", "segments", "exit", "transcript", "audio", "review"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "moment": { "type": "string" },
    "focus": { "type": "string" },
    "durationSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "label", "startSecond", "endSecond", "text"],
        "additionalProperties": false,
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "label": { "type": "string", "minLength": 1 },
          "startSecond": { "type": "number", "minimum": 0 },
          "endSecond": { "type": "number", "minimum": 0 },
          "optional": { "type": "boolean" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "exit": {
      "type": "object",
      "description": "Close/exit language. Must be present and non-empty; the user can always stop.",
      "required": ["language"],
      "additionalProperties": false,
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" }
      }
    },
    "transcript": {
      "type": "object",
      "required": ["sameOrigin", "text"],
      "additionalProperties": false,
      "properties": {
        "sameOrigin": { "type": "boolean", "const": true },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "audio": {
      "type": "object",
      "required": ["sameOrigin", "src"],
      "additionalProperties": false,
      "properties": {
        "sameOrigin": { "type": "boolean", "const": true },
        "src": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["draft", "in-review", "approved"] },
        "reviewer": { "type": "string" }
      }
    }
  }
}
